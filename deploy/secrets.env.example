TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
VNC_PASSWORD=replace-with-at-least-8-characters
# Optional: your HTTPS link to the login viewer (port 6080), shown when IS24 asks you to log in.
# DEPANATOR_VIEWER_URL=https://viewer.example.com/vnc.html

# Alternative: paths to private mounted files, not their values.
# Do not set both a direct value and its matching _FILE input.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
# VNC_PASSWORD_FILE=/run/secrets/viewer-password
