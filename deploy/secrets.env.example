TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
# Required. Public HTTPS address that forwards to the container's port 8080 (reverse proxy or tunnel).
# Telegram opens the "Connect ImmoScout24" page there.
DEPANATOR_PUBLIC_URL=https://depanator.example.com

# Alternative: a path to a private mounted file instead of the value.
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
