# API backend only; omit OPENAI_API_KEY for codex / ChatGPT subscription.
OPENAI_API_KEY=replace-me
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-with-positive-private-chat-id
VNC_PASSWORD=replace-with-an-8-character-password

# Alternative: paths to private mounted files, not their values.
# Do not set both a direct value and its matching _FILE input.
# OPENAI_API_KEY_FILE=/run/secrets/openai-api-key
# TELEGRAM_BOT_TOKEN_FILE=/run/secrets/telegram-bot-token
# VNC_PASSWORD_FILE=/run/secrets/viewer-password
