[Unit]
Description=Depanator Telegram apartment agent

[Container]
Image=ghcr.io/jhoogstraat/depanator:latest
ContainerName=depanator
UserNS=keep-id:uid=1000,gid=1000
User=1000:1000
Volume=depanator-data:/data:U,z
Volume=%h/.config/depanator/config.json:/config/config.json:ro,z
EnvironmentFile=%h/.config/depanator/secrets.env
PublishPort=127.0.0.1:6080:6080
ShmSize=512m
Exec=start

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=900
TimeoutStopSec=90

[Install]
WantedBy=default.target
